  {
    "shell": ["dotnet", "sln", "Acme.Router.slnx", "add", "src/Acme.Router.Domain/Acme.Router.Domain.csproj", "src/Acme.Router.Application/Acme.Router.Application.csproj", "tests/Acme.Router.ArchitectureTests/Acme.Router.ArchitectureTests.csproj"]
