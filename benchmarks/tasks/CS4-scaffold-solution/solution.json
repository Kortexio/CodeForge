  {
    "file": "tests/Acme.Router.ArchitectureTests/ArchitectureTests.cs",
    "write": "using System.Reflection;\nusing Xunit;\n\nnamespace Acme.Router.ArchitectureTests;\n\npublic class ArchitectureTests\n{\n\t[Fact]\n\tpublic void Domain_does_not_reference_Application()\n\t{\n\t\tvar domain = typeof(Acme.Router.Domain.Class1).Assembly;\n\t\tvar forbidden = domain.GetReferencedAssemblies()\n\t\t\t.Any(a => a.Name == \"Acme.Router.Application\");\n\t\tAssert.False(forbidden);\n\t}\n}\n"
  },
  {
    "file": "Directory.Build.props",
    "write": "<Project>\n  <PropertyGroup>\n    <Nullable>enable</Nullable>\n    <ImplicitUsings>enable</ImplicitUsings>\n  </PropertyGroup>\n</Project>\n"
  }
