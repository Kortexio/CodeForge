{
  "name": "opencodeide",
  "version": "0.1.0",
  "description": "OpenCodeIDE - An open-source, model-independent, memory-native, agentic coding IDE",
  "author": {
    "name": "Kortexio",
    "email": "contact@kortexio.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Kortexio/OpenCodeIDE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kortexio/OpenCodeIDE.git"
  },
  "bugs": {
    "url": "https://github.com/Kortexio/OpenCodeIDE/issues"
  },
  "keywords": [
    "ide",
    "editor",
    "ai",
    "coding",
    "agent",
    "llm",
    "vscode",
    "open-source"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./out/main.js",
  "scripts": {
    "build": "npm run build:src && npm run build:extensions",
    "build:src": "tsc -p tsconfig.json",
    "build:ai": "tsc -p tsconfig.json",
    "build:core": "tsc -p tsconfig.json",
    "build:extensions": "tsc -p extensions/opencodeide-ai/tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "watch:ai": "tsc -p tsconfig.json --watch",
    "watch:extensions": "tsc -p extensions/opencodeide-ai/tsconfig.json --watch",
    "start": "electron .",
    "test": "npm run test:unit",
    "test:unit": "jest --config tests/unit/jest.config.js --passWithNoTests",
    "test:integration": "jest --config tests/integration/jest.config.js --passWithNoTests",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 50",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "clean": "rimraf out dist",
    "verify": "npm run build && npm run test:unit",
    "vscode:setup": "node scripts/setup-vscode.mjs",
    "vscode:setup:skip-install": "node scripts/setup-vscode.mjs --skip-install",
    "vscode:brand": "node scripts/apply-branding.mjs && node scripts/apply-vscode-patches.mjs",
    "vscode:install": "npm --prefix vscode install",
    "vscode:compile": "npm --prefix vscode run compile-client",
    "vscode:compile:all": "npm --prefix vscode run compile",
    "vscode:watch": "npm --prefix vscode run watch",
    "vscode:dev": "node scripts/dev-vscode.mjs",
    "package": "npm run clean && npm run build && electron-builder --dir",
    "package:win": "npm run clean && npm run build && electron-builder --win --dir",
    "package:mac": "npm run clean && npm run build && electron-builder --mac --dir",
    "package:linux": "npm run clean && npm run build && electron-builder --linux --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "electron-updater": "^6.1.0",
    "express": "^4.18.0",
    "marked": "^12.0.0",
    "node-fetch": "^3.3.0",
    "openai": "^4.60.0",
    "tree-sitter": "^0.21.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "build": {
    "appId": "com.kortexio.opencodeide",
    "productName": "OpenCodeIDE",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json",
      "product.json"
    ],
    "extraResources": [
      {
        "from": "resources/binaries/win32",
        "to": "binaries",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "resources/icons/mac/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "rpm",
          "arch": ["x64"]
        },
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icons/linux",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Kortexio",
      "repo": "OpenCodeIDE"
    }
  }
}
