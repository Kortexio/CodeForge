{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "extensions/codeforge/src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "vscode",
    "VSCode-win32-x64",
    "extensions/codeforge/out"
  ]
}
